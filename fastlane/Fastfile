require 'json'
require 'fileutils'

def release_manifest
  JSON.parse(File.read(File.expand_path('../.artifacts/release/release.json', __dir__)))
end

def play_options
  {
    package_name: 'com.mannaworks.mela',
    json_key_data: ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON'),
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    metadata_path: File.expand_path('../.artifacts/release/metadata', __dir__)
  }
end

def write_notes(manifest)
  path = File.expand_path('../.artifacts/release/metadata/en-US/changelogs', __dir__)
  FileUtils.mkdir_p(path)
  File.write(File.join(path, "#{manifest.fetch('versionCode')}.txt"), manifest.fetch('notes'))
end

default_platform(:android)
platform :android do
  desc 'Upload the prepared AAB to internal testing; leave store graphics and descriptions alone'
  lane :internal do
    m = release_manifest
    UI.user_error!('Unsigned build cannot be uploaded') unless m.fetch('signed')
    write_notes(m)
    upload_to_play_store(**play_options, aab: File.expand_path('../.artifacts/release/alba.aab', __dir__), track: 'internal', release_status: 'completed', version_name: "#{m.fetch('version')} (#{m.fetch('versionCode')})", mapping: File.expand_path('../.artifacts/release/mapping.txt', __dir__))
  end

  desc 'Promote the selected internal build to production without rebuilding or uploading a binary'
  lane :production do
    m = release_manifest
    codes = google_play_track_version_codes(package_name: 'com.mannaworks.mela', json_key_data: ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON'), track: 'internal')
    UI.user_error!('Selected build is not currently on the internal testing track') unless codes.include?(m.fetch('versionCode'))
    upload_to_play_store(**play_options, track: 'internal', track_promote_to: 'production', version_code: m.fetch('versionCode'), release_status: 'completed', skip_upload_apk: true, skip_upload_aab: true)
  end
end
